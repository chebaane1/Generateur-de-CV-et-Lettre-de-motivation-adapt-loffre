# Copy this file to .env and fill in your values.
# Your name and contact details go in prompts/profile.md (contact block at the top), not here.

# Claude: token from `claude setup-token` (Pro plan). Never set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=

# Local model: Ollama model to download and use
OLLAMA_MODEL=qwen2.5:3b

# Gemini: key from https://aistudio.google.com (fallback model used when the main one is overloaded)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: only if GitHub rate-limits the projects lookup
GITHUB_TOKEN=
