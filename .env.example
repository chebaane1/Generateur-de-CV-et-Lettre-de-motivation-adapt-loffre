# Copy this file to .env and fill in your values.

# Contact details: fallback on the CV, and the sender of the cover letter
CV_NAME=YOUR_NAME
CV_LOCATION=YOUR_CITY, YOUR_COUNTRY
CV_EMAIL=your.email@example.com
CV_PHONE=+000 00 000 000
CV_GITHUB=github.com/your-account
CV_LINKEDIN=linkedin.com/in/your-profile

# Claude: token from `claude setup-token` (Pro plan). Never set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=

# Local model: Ollama model to download and use
OLLAMA_MODEL=qwen2.5:3b

# Gemini: key from https://aistudio.google.com (fallback model used when the main one is overloaded)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: only if GitHub rate-limits the projects lookup
GITHUB_TOKEN=
