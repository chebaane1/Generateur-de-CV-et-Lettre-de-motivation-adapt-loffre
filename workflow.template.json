    {"parameters":{"jsCode":"const staticData = $getWorkflowStaticData('global');\nconst updates = $input.first().json.result || [];\nif (!updates.length) return [];\nstaticData.lastOffset = Math.max(...updates.map(update => update.update_id)) + 1;\nreturn updates.filter(update => (update.message?.text || '').trim().length > 20).map(update => ({ json: update }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[800,16],"id":"filter-messages","name":"Filter Job Offers"},
