    {"parameters":{"modelId":{"__rl":true,"value":"models/gemini-1.5-flash","mode":"list"},"messages":{"values":[{"content":"=Adapt this resume to the job offer below. Use only the candidate profile supplied by the user; never invent facts or metrics. Return valid JSON matching the API fields.\n\nJOB OFFER:\n{{ $('Filter Job Offers').item.json.message.text }}\n\nCANDIDATE PROFILE (replace YOUR_CANDIDATE_PROFILE before use):\nYOUR_CANDIDATE_PROFILE"}]},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.2,"position":[1040,272],"id":"generate-resume","name":"Generate Resume JSON"},
    {"parameters":{"jsCode":"let text = $input.first()?.json?.content?.parts?.[0]?.text || $input.first()?.json?.text || '';\ntext = text.replace(/```(?:json)?/gi, '').replace(/```/g, '').trim();\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (match) text = match[0];\nreturn [{ json: JSON.parse(text) }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1280,272],"id":"parse-resume","name":"Parse Resume JSON"},
